{
  "name": "trevenant",
  "version": "1.0.0",
  "description": "Zero-dependency structured JSON logger with Stage 2 AI-native sinks, gen_ai helpers, and MCP log access",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "panasch-mcp": "./dist/mcp/bin.js",
    "panasch-codemod": "./codemod/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context/node": {
      "types": "./dist/context/node.d.ts",
      "import": "./dist/context/node.js"
    },
    "./sinks": {
      "types": "./dist/sinks/index.d.ts",
      "import": "./dist/sinks/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "release": "semantic-release",
    "typecheck": "tsc --noEmit",
    "test": "yarn build && node --test test/*.test.js",
    "mcp": "node ./dist/mcp/bin.js",
    "codemod": "node ./codemod/index.mjs",
    "playground": "node ./playground/serve.mjs",
    "generate:demo-gif": "bash ./scripts/generate-demo-gif.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrishg/panasch.git"
  },
  "keywords": [
    "logging",
    "logger",
    "json",
    "edge",
    "opentelemetry",
    "gen_ai",
    "mcp"
  ],
  "author": "Krish Gupta <hi@krshkun.co>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ikrishg/panasch/issues"
  },
  "homepage": "https://github.com/ikrishg/panasch#readme",
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "9.8.0",
    "@modelcontextprotocol/sdk": "1.11.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.2",
    "@semantic-release/npm": "12.0.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/node": "22.15.18",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "eslint": "9.26.0",
    "eslint-config-standard": "17.1.0",
    "eslint-config-love": "119.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.8.3",
    "prettier-config-standard": "7.0.0",
    "semantic-release": "24.2.3",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "codemod",
    "playground",
    "docs",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
