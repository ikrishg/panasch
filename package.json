{
  "name": "trevenant",
  "version": "1.0.0",
  "description": "Zero-dependency structured JSON logger for universal runtimes (Stage 1: Panasch)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context/node": {
      "types": "./dist/context/node.d.ts",
      "import": "./dist/context/node.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "yarn build && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikrishg/panasch.git"
  },
  "keywords": [
    "logging",
    "logger",
    "json",
    "edge",
    "opentelemetry"
  ],
  "author": "Krish Gupta <hi@krshkun.co>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ikrishg/panasch/issues"
  },
  "homepage": "https://github.com/ikrishg/panasch#readme",
  "devDependencies": {
    "@faker-js/faker": "9.8.0",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "11.0.2",
    "@semantic-release/npm": "12.0.1",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/node": "22.15.18",
    "@typescript-eslint/eslint-plugin": "8.59.1",
    "eslint": "9.26.0",
    "eslint-config-standard": "17.1.0",
    "eslint-config-love": "119.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "prettier": "3.8.3",
    "prettier-config-standard": "7.0.0",
    "semantic-release": "24.2.3",
    "typescript": "5.9.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
